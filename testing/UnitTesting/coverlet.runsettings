<RunSettings>
    <DataCollectionRunSettings>
        <DataCollectors>
            <DataCollector friendlyName="XPlat Code Coverage">
                <Configuration>
                    <ExcludeByFile>
                        **/Program.cs,
                        **/Core/DTOs/**/*.cs,
                        **/Migrations/**/*.cs,
                        **/obj/**,
                        **/bin/**,
                        **/Controller/**/*.cs
                    </ExcludeByFile>
                    <ExcludeByAttribute>
                        GeneratedCodeAttribute
                        CompilerGeneratedAttribute
                        ExcludeFromCodeCoverageAttribute
                    </ExcludeByAttribute>
                </Configuration>
            </DataCollector>
        </DataCollectors>
    </DataCollectionRunSettings>
</RunSettings>