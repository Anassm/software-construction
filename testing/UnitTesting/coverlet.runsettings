<RunSettings>
    <DataCollectionRunSettings>
        <DataCollectors>
            <DataCollector friendlyName="XPlat Code Coverage">
                <Configuration>

                    <Exclude>
                        <ModulePath>.*Migrations.*</ModulePath>
                        <ModulePath>.*DTO.*</ModulePath>
                        <ModulePath>.*Program.*</ModulePath>
                        <ModulePath>.*Startup.*</ModulePath>
                    </Exclude>

                    <ExcludeByFile>
                        <File>**/Program.cs</File>
                        <File>**/*Dto.cs</File>
                        <File>**/*DTO.cs</File>
                        <File>**/Migrations/*.cs</File>
                    </ExcludeByFile>

                    <ExcludeByAttribute>
                        <Attribute>GeneratedCodeAttribute</Attribute>
                        <Attribute>CompilerGeneratedAttribute</Attribute>
                        <Attribute>ExcludeFromCodeCoverageAttribute</Attribute>
                    </ExcludeByAttribute>

                </Configuration>
            </DataCollector>
        </DataCollectors>
    </DataCollectionRunSettings>
</RunSettings>