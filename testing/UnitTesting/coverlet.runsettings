<RunSettings>
    <DataCollectionRunSettings>
        <DataCollectors>
            <DataCollector friendlyName="XPlat Code Coverage">
                <Configuration>
                    <ExcludeByFile>
                        **/Program.cs,
                        **/Core/DTOs/**/*.cs,
                        **/Migrations/**/*.cs,
                        **/obj/**,
                        **/bin/**,
                        **/Controller/**/*.cs,
                        **/infrastructure/data/**/ImportService.*,
                        **/infrastructure/data/**/Coordinates.*,
                        **/infrastructure/data/**/ParkingLotJson.*,
                        **/infrastructure/data/**/PaymentJson.*,
                        **/infrastructure/data/**/PaymentTransactionData.*,
                        **/infrastructure/data/**/ReservationJson.*,
                        **/infrastructure/data/**/SessionJson.*,
                        **/infrastructure/data/**/UserJson.*,
                        **/infrastructure/data/**/VehicleJson.*
                    </ExcludeByFile>
                    <ExcludeByAttribute>
                        GeneratedCodeAttribute
                        CompilerGeneratedAttribute
                        ExcludeFromCodeCoverageAttribute
                    </ExcludeByAttribute>
                </Configuration>
            </DataCollector>
        </DataCollectors>
    </DataCollectionRunSettings>
</RunSettings>