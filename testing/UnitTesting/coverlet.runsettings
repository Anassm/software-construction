<RunSettings>
    <DataCollectionRunSettings>
        <DataCollectors>
            <DataCollector friendlyName="XPlat Code Coverage">
                <Configuration>

                    <ExcludeByFile>
                        <File>**/v2/Program.cs</File>
                        <File>**/v2/Core/DTOs/*DTO.cs</File>
                        <File>**/v2/Migrations/*.cs</File>
                    </ExcludeByFile>

                    <ExcludeByAttribute>
                        <Attribute>GeneratedCodeAttribute</Attribute>
                        <Attribute>CompilerGeneratedAttribute</Attribute>
                        <Attribute>ExcludeFromCodeCoverageAttribute</Attribute>
                    </ExcludeByAttribute>

                </Configuration>
            </DataCollector>
        </DataCollectors>
    </DataCollectionRunSettings>
</RunSettings>